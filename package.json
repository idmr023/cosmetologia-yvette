{
  "name": "pws-peliqueria-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:backend\"",
    "build": "cd frontend && npm run build",
    "seed": "cd frontend && npm run seed",
    "test": "cd frontend && npm run test",
    "test:e2e": "cd frontend && npx playwright test --config playwright.config.ts",
    "test:e2e:ui": "cd frontend && npx playwright test --ui --config playwright.config.ts",
    "test:e2e:debug": "cd frontend && npx playwright test --debug --config playwright.config.ts",
    "test:e2e:seed": "cd frontend && npx tsx scripts/seed-e2e.ts",
    "seed-e2e": "cd frontend && npx tsx scripts/seed-e2e.ts"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "next": "^14.2.5",
    "playwright": "^1.61.1"
  }
}
